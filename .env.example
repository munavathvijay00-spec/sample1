# Ethereum Sepolia Testnet Configuration
# You can use a public RPC (default) or an Alchemy/Infura RPC URL:
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Private Key of the deployer & agent wallet (must have testnet SepoliaETH for gas)
# Faucets: https://cloud.google.com/application/web3/faucet/ethereum/sepolia or https://sepoliafaucet.com
PRIVATE_KEY=your_private_key_here

# AI / LLM API Configuration (Either Gemini or OpenAI, or both)
# If left empty, the agent will use an intelligent algorithmic momentum model for demo testing
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Flask Web Server Port (Port 5050 avoids macOS AirPlay conflict on 5000)
PORT=5050
