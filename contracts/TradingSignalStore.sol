pragma solidity ^0.8.20;

/**
 * @title TradingSignalStore
 * @dev Stores AI generated trading decisions and market signals immutably on Ethereum Sepolia testnet.
 */
contract TradingSignalStore {
    struct Signal {
        uint256 id;
        uint256 timestamp;
        string asset;         // e.g. "ETH/USD"
        uint256 price;        // price scaled by 1e2 (e.g. $3,450.50 = 345050)
        string decision;      // "BUY", "SELL", or "HOLD"
        string reasoning;     // summary rationale from LLM
        address reporter;     // agent address who submitted
    }

    Signal[] private signals;
    address public owner;

    event SignalRecorded(
        uint256 indexed id,
        string asset,
        string decision,
        uint256 price,
        uint256 timestamp,
        address indexed reporter
    );

    constructor() {
        owner = msg.sender;
    }

    /**
     * @notice Record a new trading signal generated by the AI agent
     * @param _asset Symbol of the asset (e.g., "ETH/USD")
     * @param _price Asset price scaled by 100 (in USD cents)
     * @param _decision Action recommended ("BUY", "SELL", "HOLD")
     * @param _reasoning Rationale provided by the LLM
     */
    function recordSignal(
        string calldata _asset,
        uint256 _price,
        string calldata _decision,
        string calldata _reasoning
    ) external returns (uint256) {
        uint256 newId = signals.length;
        Signal memory newSignal = Signal({
            id: newId,
            timestamp: block.timestamp,
            asset: _asset,
            price: _price,
            decision: _decision,
            reasoning: _reasoning,
            reporter: msg.sender
        });

        signals.push(newSignal);

        emit SignalRecorded(
            newId,
            _asset,
            _decision,
            _price,
            block.timestamp,
            msg.sender
        );

        return newId;
    }

    /**
     * @notice Get total number of recorded signals
     */
    function getSignalCount() external view returns (uint256) {
        return signals.length;
    }

    /**
     * @notice Retrieve the latest recorded signal
     */
    function getLatestSignal() external view returns (
        uint256 id,
        uint256 timestamp,
        string memory asset,
        uint256 price,
        string memory decision,
        string memory reasoning,
        address reporter
    ) {
        require(signals.length > 0, "No signals recorded yet");
        Signal storage s = signals[signals.length - 1];
        return (
            s.id,
            s.timestamp,
            s.asset,
            s.price,
            s.decision,
            s.reasoning,
            s.reporter
        );
    }

    /**
     * @notice Retrieve a specific signal by index
     */
    function getSignal(uint256 index) external view returns (
        uint256 id,
        uint256 timestamp,
        string memory asset,
        uint256 price,
        string memory decision,
        string memory reasoning,
        address reporter
    ) {
        require(index < signals.length, "Index out of bounds");
        Signal storage s = signals[index];
        return (
            s.id,
            s.timestamp,
            s.asset,
            s.price,
            s.decision,
            s.reasoning,
            s.reporter
        );
    }

    /**
     * @notice Retrieve up to `count` most recent signals (latest first)
     */
    function getRecentSignals(uint256 count) external view returns (Signal[] memory) {
        uint256 total = signals.length;
        if (total == 0) {
            return new Signal[](0);
        }

        uint256 returnCount = count > total ? total : count;
        Signal[] memory result = new Signal[](returnCount);

        for (uint256 i = 0; i < returnCount; i++) {
            result[i] = signals[total - 1 - i];
        }

        return result;
    }
}
